    {
      "label": "Agency",
      "meaning": "Published transit operator",
      "source": "agency",
      "identity": "canonical_id",
      "entity_type": "agency",
      "join": "canonical_ids.entity_type = 'agency' AND canonical_ids.source_identifier = agency.agency_id",
      "properties": {
        "canonical_id": {
          "type": "STRING",
          "source": "canonical_ids.canonical_id",
          "required": true
        },
        "source_id": {
          "type": "STRING",
          "source": "canonical_ids.source_identifier",
          "required": true
        },
        "agency_name": {
          "type": "STRING",
          "source": "agency.agency_name",
          "required": true
        },
        "agency_timezone": {
          "type": "STRING",
          "source": "agency.agency_timezone",
          "required": true
        }
      },
      "grounding": "AgencyId and service timezone",
      "storage": "graph",
      "classification": "static"
    },
    {
      "label": "Route",
