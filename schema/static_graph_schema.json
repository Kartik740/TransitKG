{
  "version": "1.0.0",
  "cardinality_evidence": "../reports/phase4/architecture_comparison.json",
  "count_lookup": "nodes[label] and edges[type] in cardinality_evidence for its identified build",
  "node_uniqueness": "Per label, require the declared identity to be unique and non-null. Across entity nodes, validate the feed-scoped canonical mapping bijection before import.",
  "validation": "Required means present with the declared type. Null optional values are omitted on graph records. Validate all endpoint domains, relationship identity tuples and declared multiplicities before publication.",
  "source_lineage": "../reports/phase4/phase5_transformation_contract.md",
  "canonical_contract_version": "1.0.0",
  "namespace": "511-sf-bay-regional",
  "canonical_rule": "Copy the exact Phase 3 canonical_id for (entity_type, source_identifier). Preserve original UTF-8 spelling.",
